{
    "name": "pokesag_webapp",
    "version": "1.0.0",
    "description": "WebApp component of PokéSAG",
    "author": "Joppy Furr",
    "license": "MIT",
    "main": "app.mjs",
    "scripts": {
        "build-development": "esbuild client/main.jsx --bundle --outfile=client/dist/main.js --sourcemap --jsx=automatic",
